# Copy to .env.local (development), or configure the equivalent values in
# Vercel's Environment Variables UI for staging/production. NEVER commit a
# file containing real values — .env.local is gitignored.
#
# Every environment (dev/staging/prod) gets its OWN Supabase project and its
# OWN Stripe keys (test mode for dev/staging, live mode for prod only). Never
# share a database or Stripe account across environments.

# --- Supabase ---------------------------------------------------------------
# Public — safe to expose to the browser (Supabase's anon key is designed for
# this; RLS is what actually protects data, not secrecy of this key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_,
# never log it, never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection strings (used by lib/db/migrate.ts and the
# service-role Drizzle client in lib/db/client.ts). Use Supabase's POOLED
# (Supavisor, transaction-mode, port 6543) connection string for
# DATABASE_URL_SERVICE_ROLE at runtime; the direct (port 5432) connection is
# fine for one-off migration runs from CI.
DATABASE_URL=
DATABASE_URL_SERVICE_ROLE=

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (email) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Scheduled jobs ------------------------------------------------------------
# Random secret shared with Vercel Cron so /api/cron/* can't be triggered by
# an arbitrary public request. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Monitoring ----------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
